NODE_ENV=development
PORT=5000

# Paste your real Atlas password in place of <db_password> in your local server/.env file.
# Never commit server/.env to GitHub.
MONGODB_URI=mongodb+srv://karmughil112_db_user:<db_password>@karmughil.bmgaifp.mongodb.net/libraryDB?retryWrites=true&w=majority&appName=karmughil

# Generate a private secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Comma-separated allowed browser origins. Local Vite traffic is proxied to Express.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
